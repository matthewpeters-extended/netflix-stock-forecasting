# Data: regenerated by src/data.py, never commit
data/raw/*
data/processed/*
!data/**/.gitkeep

# Except the results tables. These are the project's findings, they are small,
# and notebook 06 reads them, so a fresh clone must have them.
!data/processed/results_*.csv

# Environment
.venv/
venv/
__pycache__/
*.py[cod]
.python-version

# Notebooks
.ipynb_checkpoints/

# Trained model artifacts. Deliberately NOT a bare "models/" rule: that also
# matches src/models/, which is source code and must be committed.
*.h5
*.keras
/saved_models/

# macOS
.DS_Store

# Tooling
.pytest_cache/
.ruff_cache/
*.egg-info/
